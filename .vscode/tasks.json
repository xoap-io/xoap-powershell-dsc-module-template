{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Module",
            "type": "shell",
            "command": "${workspaceFolder}/build.ps1",
            "args": ["-Tasks", "build"],
            "group": {"kind": "build", "isDefault": true},
            "presentation": {"reveal": "always", "panel": "new"},
